#!/usr/bin/env bash
#
# Stand-in for `gh`, used by test/loop_test.sh. Talks to no network.
#
# The open-issue queue is a file, so closing an issue really does shorten the queue and the loop
# terminates the way it would against GitHub. It ignores the --jq expressions and prints what those
# expressions would have produced.
#
set -uo pipefail

: "${STUB_DIR:?stub needs STUB_DIR}"
open="$STUB_DIR/open-issues"
printf 'gh %s\n' "$*" >> "$STUB_DIR/gh-calls"

# wants <needle> "$@" : the exact string appears as one of the remaining arguments.
# (shift first — otherwise the needle is in its own haystack and every call matches)
wants() { local needle="$1"; shift; printf '%s\n' "$@" | grep -qxF "$needle"; }

case "${1:-} ${2:-}" in
  "auth status")
    exit 0 ;;

  # git's credential-helper protocol, which git invokes as `gh auth git-credential get` with the
  # request on stdin. Modelled on the real thing's failure mode as much as its success one: gh with no
  # usable token exits non-zero rather than returning an empty credential, and that non-zero is what
  # run.sh's preflight is looking for. STUB_GH_CRED unset therefore means "no token", which is the
  # state a container has whenever GH_TOKEN was stripped.
  "auth git-credential")
    [ -n "${STUB_GH_CRED:-}" ] || { echo "stub gh: no token" >&2; exit 1; }
    [ "${3:-}" = get ] || exit 0
    printf 'username=x-access-token\npassword=%s\n' "$STUB_GH_CRED" ;;

  # `gh api -i user`, which run.sh reads for the token's scopes. The header is the whole point, so this
  # prints headers and a body the way the real thing does. STUB_GH_SCOPES unset means the header is
  # absent altogether, which is what a fine-grained PAT does and is a third case rather than an empty
  # second one.
  "api -i")
    printf 'HTTP/2.0 200 OK\r\n'
    [ -z "${STUB_GH_SCOPES+x}" ] || printf 'X-OAuth-Scopes: %s\r\n' "$STUB_GH_SCOPES"
    printf 'X-Accepted-Oauth-Scopes: \r\n'
    printf '\r\n{"login":"stub"}\n' ;;

  "issue list")
    if wants length "$@"
      then grep -c . "$open"
      else grep . "$open" || true
    fi ;;

  "issue view")
    n="$3"
    if wants .title "$@"; then
      printf 'Stub issue %s\n' "$n"
    else
      printf '# Stub issue %s\n\n' "$n"
      printf 'A synthetic issue body, long enough that run.sh does not warn about an empty\n'
      printf 'description. The stub implementer ignores it.\n'
    fi ;;

  "issue close")
    n="$3"
    grep -vxF "$n" "$open" > "$open.tmp" || true
    mv "$open.tmp" "$open"
    printf '%s\n' "$n" >> "$STUB_DIR/closed" ;;

  "issue edit")    printf '%s\n' "$*" >> "$STUB_DIR/edited" ;;
  "issue comment") printf '%s\n' "$*" >> "$STUB_DIR/commented" ;;

  *)
    echo "stub gh: unhandled command: $*" >&2
    exit 1 ;;
esac
