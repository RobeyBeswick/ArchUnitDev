#!/usr/bin/env bash
#
# Stand-in for `opencode run`, used by test/loop_test.sh. Contacts no model and costs nothing.
#
# It works out which invocation it is from the --title argument, because that is the only place
# run.sh puts the tag ("2-implement", "2-review-1", "2-fix-2", ...) into the command line. It
# captures its stdin so the test can assert on what the harness actually put in each prompt, and
# it edits the working tree for implement/fix invocations so the diff the critics see is non-empty.
#
# It emits the ndjson event stream `opencode run --format json` produces — step_start, text,
# step_finish — so that run.sh's real envelope synthesis is what is exercised here.
#
set -uo pipefail

# Non-run invocations the harness makes during preflight. They are not an agent call, so they have
# no tag and no stdin to capture; succeed so the preflight does not die.
case "${1:-}" in
  auth|models) exit 0 ;;
esac

: "${STUB_DIR:?stub needs STUB_DIR}"
: "${SCENARIO:?stub needs SCENARIO}"

tag=""
prev=""
for a in "$@"; do
  [ "$prev" = "--title" ] && tag="$a"
  prev="$a"
done
[ -n "$tag" ] || { echo "stub opencode: no --title in args" >&2; exit 64; }

mkdir -p "$STUB_DIR"
cat > "$STUB_DIR/$tag.stdin"
printf '%s\n' "$tag" >> "$STUB_DIR/calls"

# Whether the GitHub token reached this invocation. It is the harness's one enforced boundary — the
# prompts ask the implementer not to push, `env -u GH_TOKEN` is what makes it impossible — so it is
# worth an assertion rather than a comment. Recorded per tag, because "stripped for the critics but
# not the fixer" is exactly the kind of regression a single check would miss.
printf '%s %s\n' "$tag" "${GH_TOKEN:-(unset)}" >> "$STUB_DIR/tokens"

round="${tag##*-}"   # meaningless for "*-implement", unused there
issue="${tag%%-*}"

# The ndjson stream run.sh reads: last text part = result, sum of step_finish cost = total_cost_usd,
# count of step_finish = num_turns, last reason = terminal_reason.
emit() {
  jq -cn '{type:"step_start",part:{type:"step-start"}}'
  jq -cn --arg t "$1" '{type:"text",part:{type:"text",text:$t}}'
  jq -cn --argjson c "$2" '{type:"step_finish",part:{type:"step-finish",reason:"stop",tokens:{total:3,input:2,output:1},cost:$c}}'
}

result() {
  emit "$1" 0.01
}

# A critic answer. It is plain text (the verdict JSON), because opencode's run mode has no native
# JSON-schema flag; run.sh's oc_verdict validates it and fails closed on anything unparseable.
verdict_pass() {
  emit '{"verdict":"PASS","findings":[]}' 0.02
}
verdict_fail() {
  local v
  v=$(jq -cn --arg f "$1" --arg p "$2" --arg x "$3" '{verdict:"FAIL",findings:[{file:$f,problem:$p,fix:$x}]}')
  emit "$v" 0.02
}

# The real model does not always answer in one line of JSON. It has been measured wrapping the verdict
# in a ```json fence and pretty-printing it across several lines; the old extractor read that as "no
# verdict" and failed closed, which abandoned an issue whose final verdicts were PASS everywhere. This
# is that shape, on purpose, so the suite pins the extraction rather than the formatting.
verdict_pass_fenced() {
  emit '```json
{
  "verdict": "PASS",
  "findings": []
}
```' 0.02
}

# The model has also been measured echoing the verdict schema back before answering — which makes the
# output two JSON documents, and the extractor's first attempt (validate the last document, then print
# every one of them) wrote a two-object verdict file. Read `.verdict` off that and a PASS becomes a
# silent abandonment. This is that shape: schema echo first, real verdict second.
verdict_pass_schema_echo() {
  emit '{"type":"object","properties":{"verdict":{"enum":["PASS","FAIL"]},"findings":{"type":"array","items":{"type":"object","properties":{"file":{"type":"string"},"problem":{"type":"string"},"fix":{"type":"string"}}}}}}' 0.02
  emit '{"verdict":"PASS","findings":[]}' 0.02
}

case "$tag" in
  *-implement)
    # An implementer that returns having changed nothing — what a real one does when it reads the
    # issue and finds the work already there. It still reports for duty and still costs money; the
    # tree is what run.sh has to act on, not the prose.
    if [ "$SCENARIO" = nodiff ]; then
      result "Issue $issue is already implemented by the code that is there; I changed nothing."
    else
      # One file per issue, not one file for the run: with a fixed name and fixed contents a second
      # issue rewrites byte-identical content, run.sh sees an empty diff, and the two-issue scenario
      # would report a queue bug it does not have (or hide one it does).
      printf 'a feature for issue %s, implemented by the stub\n' "$issue" > "feature-$issue.txt"
      result "Added feature-$issue.txt."
    fi
    ;;

  *-fix-*)
    # The fix a real fixer would make, reduced to its observable effect: the tree changes, and the
    # thing the reviewer objected to is now satisfiable.
    printf 'FIXROUND-ACK: addressed the finding from round %s\n' "$round" >> NOTES.md
    result "Addressed the findings; see NOTES.md."
    ;;

  *-review-*)
    case "$SCENARIO" in
      happy|testcritic|union|fencedjson|schemaecho) verdict_pass ;;
      fixround)
        if grep -q FIXROUND-ACK NOTES.md 2>/dev/null
          then verdict_pass
          else verdict_fail "feature-$issue.txt" \
                 "feature.txt is asserted by no test." \
                 "Add a test that fails if feature.txt is empty."
        fi ;;
      garbage)
        # Round 1 returns prose instead of JSON — a crashed, truncated or budget-capped critic.
        # run.sh must fail closed rather than read this as a pass.
        if [ "$round" = 1 ]
          then printf 'I was not able to complete the review.\n'
          else verdict_pass
        fi ;;
      always_fail)
        verdict_fail "feature-$issue.txt" "Still not right." "Try again." ;;
      # Satisfied only by the third fix, so the verdict that decides this issue is the one taken after
      # the last fix — the round that did not used to exist. Under a loop bounded at MAX_ROUNDS rounds
      # this issue abandons with work that every critic would have passed.
      late_pass)
        acks=$(grep -c FIXROUND-ACK NOTES.md 2>/dev/null)
        if [ "${acks:-0}" -ge 3 ]
          then verdict_pass
          else verdict_fail "feature-$issue.txt" "Not there yet." "Keep going."
        fi ;;
      # The lowest issue in the queue is the one that cannot be satisfied; the rest are fine. A queue
      # that abandons its way through is what tells MAX_ISSUES apart from a bound on landings.
      fail_one)
        if [ "$issue" = 2 ]
          then verdict_fail "feature-$issue.txt" "Not right, and it will not become right." "Try again."
          else verdict_pass
        fi ;;
      # The lowest issue in the queue cannot be got right until the issue *after* it has landed: the
      # backlog's dependency order with a hole in it, which is what an abandonment in the middle of an
      # ordered queue leaves behind. No round of fixing helps, and the same implementer succeeds
      # unchanged once the tree has the thing it was missing.
      retry)
        if [ "$issue" = 2 ] && [ ! -f feature-3.txt ]
          then verdict_fail "feature-$issue.txt" \
                 "This needs what issue 3 provides, and it is not in the tree." \
                 "Nothing this round can do about it."
          else verdict_pass
        fi ;;
      *) echo "stub opencode: unknown SCENARIO $SCENARIO" >&2; exit 64 ;;
    esac
    ;;

  *-idiom-*)
    verdict_pass
    ;;

  *-tests-*)
    case "$SCENARIO" in
      # The critic answers with the fenced multi-line verdict that previously failed closed. The
      # verdict is PASS, so if the extractor regresses the run abandons instead of landing — which
      # is the assertion the scenario makes.
      fencedjson) verdict_pass_fenced ;;
      # The critic echoes the schema JSON and then answers — two documents. The old first-attempt
      # extractor wrote both to the verdict file; read off that, a PASS verdict reads as "null"
      # first and the issue abandons. The extractor must take the single real document.
      schemaecho) verdict_pass_schema_echo ;;
      # Two concurrent passes of the same critic, each seeing something the other does not — the
      # measured failure DOUBLE_CRITICS exists for. Which pass this is comes from the tag, which is
      # also the only thing that differs between the two invocations.
      union)
        if grep -q FIXROUND-ACK NOTES.md 2>/dev/null; then verdict_pass
        elif [ "${tag%b}" != "$tag" ]; then
          verdict_fail "sweep_test.go" "The second thing, which only an exhaustive pass finds." "Assert on it."
        else
          verdict_fail "feature_test.go" "The most important thing." "Assert on it."
        fi ;;
      # The test critic objects while the other two pass. That is what proves run.sh sends the fixer
      # one findings section rather than an empty heading for every critic that had nothing to say.
      testcritic)
        if grep -q FIXROUND-ACK NOTES.md 2>/dev/null
          then verdict_pass
          else verdict_fail feature_test.go \
                 "Nothing asserts that feature.txt is non-empty." \
                 "Assert on its contents: emptying the file must fail the test."
        fi ;;
      *) verdict_pass ;;
    esac
    ;;

  retro-*)
    # The retrospective. Its output is markdown for a human, not a schema, so the only thing the
    # stub has to be faithful about is where it comes back: the last text part.
    result "## Verdict
The loop landed the batch in one round each. No change needed.

## Findings
None worth making from a batch this size."
    ;;

  *)
    echo "stub opencode: unrecognised tag $tag" >&2; exit 64 ;;
esac
