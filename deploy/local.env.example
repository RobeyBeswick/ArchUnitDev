# The account-specific values the harness needs and this repository deliberately does not carry.
#
# None of these is a secret in the way a token is — an account ID cannot be authenticated with, and the
# log bucket denies everything it is not explicitly asked to allow. They are here because they *name
# real infrastructure*, and a public repository is the wrong place to publish an inventory of it: an
# account ID plus a globally-unique bucket name is enough to probe both.
#
# Copy this file, fill it in, and source it. The copy is git-ignored:
#
#   cp deploy/local.env.example deploy/local.env && $EDITOR deploy/local.env
#   set -a && . deploy/local.env && set +a
#
# On the loop host none of it is needed. The bootstrap writes the same values to
# /etc/profile.d/archunitdev.sh from the Terraform outputs, and credentials come from the instance
# profile rather than from a helper.

# The account Bedrock inference is billed to. Nothing reads this to authenticate — it is here so that
# `aws sts get-caller-identity` can be checked against the account you meant, before a night of spend
# goes to the wrong one.
AWS_ACCOUNT_ID=

# The region the loop runs in. Must be one the pinned model is available in.
AWS_REGION=us-east-1

# The log bucket Terraform created, as a URI including the prefix — what log-sync.sh wants for S3_LOGS.
# The run scripts in deploy/runs/ want the bucket root and derive it from this by stripping /loop.
# `terraform -chdir=deploy/terraform output -raw log_bucket` prints the bare name.
S3_LOGS=

# The Secrets Manager secret holding the GitHub PAT. The secret's *name*, never its value.
GH_TOKEN_SECRET=archunitdev/gh-token

# How to mint short-lived credentials for a smoke test from a laptop, printed as KEY=VALUE pairs.
# Whichever federation tool your organisation uses; with plain AWS SSO it is
#   aws configure export-credentials --profile <profile> --format env-no-export
# Not needed on the instance, which has a role.
AWS_CREDS_CMD=
